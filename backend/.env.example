# ============================================================
# AI 智能面试助手 —— 配置样例
# 用法：复制本文件为 .env 并填写实际值
#      cp .env.example .env
# 注意：本文件不得包含任何真实密钥
# ============================================================

# --- 必填 ---

# MySQL 连接串
#   本机开发示例：mysql+pymysql://root:123456@127.0.0.1:3306/interview_dev?charset=utf8mb4
#   生产示例：    mysql+pymysql://user:password@db-host:3306/interview?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:CHANGE_ME@127.0.0.1:3306/interview_dev?charset=utf8mb4

# JWT 签名密钥 —— 生产环境必须替换为强随机值
#   生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_use_a_long_random_secret

# --- 可选（以下均有默认值，可按需覆盖）---

# JWT 算法与有效期（分钟），默认 720 = 12 小时
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# AI Provider 选择：mock | openai
#   mock   —— 规则生成确定性结果，无需任何 API Key（演示与测试默认）
#   openai —— 调用真实大模型，需填写下面三项
PROVIDER_NAME=mock

# 真实大模型配置（PROVIDER_NAME=openai 时必填，缺任一项启动即报错）
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# 出题数量：题库抽取 N 题 + AI 补充 M 题（总题数恒为 N+M）
QUESTION_COUNT_FROM_BANK=5
QUESTION_COUNT_FROM_AI=3

# AI 调用超时（秒）与失败重试次数
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=1

# 允许的前端来源（JSON 数组格式；Vite 开发服务器，见 frontend/vite.config.js）
# 两个写法都列上：Vite 被显式绑到 127.0.0.1，而浏览器里 localhost 与 127.0.0.1
# 是两个不同的 Origin，只列一个会让另一种写法在**不走 Vite 代理**时被 CORS 拦掉。
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# 是否打印 SQL（调试用）
SQL_ECHO=false

# bcrypt 代价因子
BCRYPT_ROUNDS=12

# 初始管理员（供 scripts/seed_admin.py 使用）
# !! 生产环境必须修改默认密码 !!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345

# --- 候选人侧（PRD §4.1）---

# 候选人自助注册开关。默认 true 以便开箱演示；
# 生产部署应设为 false，此时候选人只能凭邀请码建号。
CANDIDATE_SELF_REGISTER=true

# 作答邀请码有效期（天）。过期由读取时派生，无需调度器。
INVITATION_EXPIRE_DAYS=7

# --- 刷题练习（PRD §4.7）---

# 开始练习未指定题数时的默认题量
PRACTICE_SESSION_SIZE_DEFAULT=10

# 单次练习题量的硬上限（防一次拉全库）
PRACTICE_SESSION_SIZE_MAX=20

# 会话列表 limit 的硬上限
PRACTICE_SESSION_LIST_MAX=100

# 每用户每分钟的计分动作上限。
# !! 计数是**进程内**的，因此单机部署必须用 --workers 1，多进程会让各进程各算一份。
PRACTICE_RATE_LIMIT_PER_MINUTE=60

# --- 按简历补题（PRD §4.14）---

# 单次补题的默认追加题数（请求体可覆盖，上限 20）
RESUME_MATCH_COUNT=3

# --- 简历（PRD §4.10）---

# 简历正文长度上限（字符）。超限返回 422（全项目唯一的 422，其余参数错误为 400）。
RESUME_CONTENT_MAX_LENGTH=20000

# 上传简历文件的体积上限（字节），默认 5 MB（MVP-4）。
# 超限返回 400。注意它是对**已收到的请求体**的护栏，前端另有一道 file.size
# 预检负责「根本不发请求」。
RESUME_UPLOAD_MAX_BYTES=5242880

# 候选人可见的评估反馈档位：summary（默认，仅结论/优点/待改进）| full（额外含总分）
# 取值非法会导致启动失败。逐题分与维度分在任何档位都不下发。
CANDIDATE_FEEDBACK_LEVEL=summary

# --- 手机验证码登录（PRD §4.16，MVP-5）---

# 短信通道 Provider 选择：目前只有 mock。
#   mock —— **不真的发短信**：验证码写进后端日志，并在发码响应里回显（dev_code），
#           前端会自动填好并提示「演示环境：验证码 xxxxxx」。
# !! 生产部署必须换成真实值（届时新增实现）。留在 mock 上，任何人填自己的手机号
#    就能拿到验证码并登录。取值非法时服务**拒绝启动**，不会静默退回 mock。
SMS_PROVIDER=mock

# 验证码有效期（秒）。5 分钟是「够切到短信 App 再切回来」与「暴露窗口尽量短」的折中。
PHONE_CODE_TTL_SECONDS=300

# 单个验证码的错误次数上限，达到即作废。它挡的是「拿 10^6 的空间在线暴力猜」——
# 错满 5 次该码失效，想把 10^6 试完需要重发 20 万次，而重发受下面三层限流约束。
PHONE_CODE_MAX_ATTEMPTS=5

# 同一手机号的重发间隔（秒）。
# !! 前端倒计时用的是同一个数（frontend/src/components/phone-login.js 各写一份，
#    有常量守门测试钉住）。若这里调大而前端没跟着改，用户会点了重发却吃 429。
PHONE_CODE_RESEND_INTERVAL_SECONDS=60

# 同一手机号 24 小时内的发码上限 —— 防短信轰炸，也是防真金白银被刷。
PHONE_CODE_MAX_PER_PHONE_PER_DAY=10

# 同一 IP 1 小时内的发码上限。与上一条互补：只限手机号时，攻击者可以用一批号码
# 绕开单号上限。注意本机部署下它对所有请求都是 127.0.0.1。
PHONE_CODE_MAX_PER_IP_PER_HOUR=20
