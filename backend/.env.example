# ============================================================
# AI 智能面试助手 —— 配置样例
# 用法：复制本文件为 .env 并填写实际值
#      cp .env.example .env
# 注意：本文件不得包含任何真实密钥
# ============================================================

# --- 必填 ---

# MySQL 连接串
#   本机开发示例：mysql+pymysql://root:123456@127.0.0.1:3306/interview_dev?charset=utf8mb4
#   生产示例：    mysql+pymysql://user:password@db-host:3306/interview?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:CHANGE_ME@127.0.0.1:3306/interview_dev?charset=utf8mb4

# JWT 签名密钥 —— 生产环境必须替换为强随机值
#   生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_use_a_long_random_secret

# --- 可选（以下均有默认值，可按需覆盖）---

# JWT 算法与有效期（分钟），默认 720 = 12 小时
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# AI Provider 选择：mock | openai
#   mock   —— 规则生成确定性结果，无需任何 API Key（演示与测试默认）
#   openai —— 调用真实大模型，需填写下面三项
PROVIDER_NAME=mock

# 真实大模型配置（PROVIDER_NAME=openai 时必填，缺任一项启动即报错）
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# 出题数量：题库抽取 N 题 + AI 补充 M 题（总题数恒为 N+M）
QUESTION_COUNT_FROM_BANK=5
QUESTION_COUNT_FROM_AI=3

# AI 调用超时（秒）与失败重试次数
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=1

# 允许的前端来源（JSON 数组格式；Vite 默认端口 5173）
CORS_ORIGINS=["http://localhost:5173"]

# 是否打印 SQL（调试用）
SQL_ECHO=false

# bcrypt 代价因子
BCRYPT_ROUNDS=12

# 初始管理员（供 scripts/seed_admin.py 使用）
# !! 生产环境必须修改默认密码 !!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345

# --- 候选人侧（PRD §4.1）---

# 候选人自助注册开关。默认 true 以便开箱演示；
# 生产部署应设为 false，此时候选人只能凭邀请码建号。
CANDIDATE_SELF_REGISTER=true

# 作答邀请码有效期（天）。过期由读取时派生，无需调度器。
INVITATION_EXPIRE_DAYS=7

# --- 简历（PRD §4.10）---

# 简历正文长度上限（字符）。超限返回 422（全项目唯一的 422，其余参数错误为 400）。
RESUME_CONTENT_MAX_LENGTH=20000

# 候选人可见的评估反馈档位：summary（默认，仅结论/优点/待改进）| full（额外含总分）
# 取值非法会导致启动失败。逐题分与维度分在任何档位都不下发。
CANDIDATE_FEEDBACK_LEVEL=summary
