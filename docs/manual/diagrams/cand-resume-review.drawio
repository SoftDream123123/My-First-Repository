<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="cand-resume-review">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n_s" value="在「我的简历」页选中一份简历" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="370" y="40" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n_row" value="右栏「用于面试」那一段，&#xa;每一场旁边都有一颗「评估匹配度」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="370" y="190" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n_click" value="点那一场的「评估匹配度」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="370" y="350" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n_wait" value="弹窗先显示「AI 正在评估简历与&#xa;岗位的匹配度…」，按钮变「评估中…」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="370" y="490" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n_ok" value="评估成功了吗？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="370" y="650" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n_fail" value="看到后端原样的文案，例如&#xa;「岗位未定义评估维度，无法评估简历」&#xa;（就显示在弹窗里，关掉可以重试）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="640" y="650" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n_three" value="弹窗里能看到三块：&#xa;综合结论 / 亮点 / 差距&#xa;（差距为空时写「未发现明显差距」）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="370" y="830" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n_score" value="这次开放分数了吗？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="370" y="1000" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n_no" value="看不到分数（默认如此）：&#xa;整块分数区不出现，&#xa;不会显示 0 或「暂无」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="640" y="1010" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n_yes" value="看得到匹配度分，&#xa;旁边跟一句档位说法，&#xa;例如「重合度较好」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="120" y="1010" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n_end" value="关掉弹窗。&#xa;评估结果不保存 —— 想再看就再点一次，&#xa;每次点都会重新评估" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="370" y="1180" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e_0" value="" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_s" target="n_row">
          <mxGeometry relative="1" as="geometry" />
