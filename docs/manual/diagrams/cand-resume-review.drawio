          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_7" value="没开放" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;edgeStyle=none;exitX=0.75;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_score" target="n_no">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_8" value="开放了" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;edgeStyle=none;exitX=0.25;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_score" target="n_yes">
          <mxGeometry relative="1" as="geometry" />
