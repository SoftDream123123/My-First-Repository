        <mxCell id="n_s" value="在「用户管理」列表里&#xa;找到那个人" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="370" y="40" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n_d" value="要给他加权限&#xa;还是收权限？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
