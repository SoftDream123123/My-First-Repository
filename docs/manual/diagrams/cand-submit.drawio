<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="cand-submit">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n_s" value="答完后，在页面上方的&#xa;交卷条上" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="370" y="40" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n_click" value="点「交卷」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="370" y="190" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n_flush" value="系统先把当前输入框里&#xa;还没保存的内容存好" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="370" y="340" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n_flushed" value="存下了吗？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="370" y="490" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n_dlg" value="弹出确认「交卷？」&#xa;并告诉你还有几题没答" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="220" y="640" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n_flushfail" value="存不下就停下：&#xa;看到「保存失败」，这次交卷不进行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="520" y="640" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n_confirm" value="点「交卷」还是「取消」？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="370" y="790" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n_ok" value="看到「已交卷，提交了 N 题作答」，&#xa;页面变成「已于 … 交卷」，作答锁定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="220" y="940" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n_cancel" value="点「取消」，继续作答" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="940" width="220" height="70" as="geometry" />
