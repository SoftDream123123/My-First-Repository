        <mxCell id="n_switch" value="点卡片上方的「注册」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="370" y="190" width="220" height="70" as="geometry" />
        </mxCell>
