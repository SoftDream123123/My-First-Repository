        <mxCell id="n_s" value="打开候选人端登录页" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="370" y="40" width="220" height="60" as="geometry" />
