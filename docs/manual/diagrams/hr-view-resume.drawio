        </mxCell>
        <mxCell id="n_d" value="候选人关联过简历吗？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="370" y="190" width="220" height="110" as="geometry" />
        </mxCell>
