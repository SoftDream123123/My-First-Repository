          <mxGeometry x="220" y="340" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n_none" value="看到「候选人尚未提交简历。&#xa;候选人可在其端内录入并关联，&#xa;之后可据此补充面试题。」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;" vertex="1" parent="1">
