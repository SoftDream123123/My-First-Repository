          <mxGeometry x="370" y="190" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n_dlg" value="弹出确认：「删除这份简历？」&#xa;（标题删除后无法恢复）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
