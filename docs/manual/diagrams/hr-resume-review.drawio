<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="hr-resume-review">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n_s" value="打开一场面试的详情页" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="370" y="40" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n_panel" value="滚到「候选人简历」面板，&#xa;标题右边除了「按简历补题」，&#xa;还有一颗「评估匹配度」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="370" y="190" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n_linked" value="这场面试关联了简历吗？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="370" y="360" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n_disabled" value="按钮是灰的，鼠标停上去提示&#xa;「该面试尚未关联简历」&#xa;（候选人关联之后才能评估）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="640" y="370" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n_click" value="点「评估匹配度」&#xa;（面试已完成也能点：&#xa;评估不写数据，与补题不同）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="370" y="540" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n_shown" value="弹窗里显示：&#xa;匹配度分 + 档位说法，&#xa;综合结论 / 亮点 / 差距" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="370" y="710" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n_fail" value="看到后端原样的文案，例如&#xa;「AI 服务调用失败，请稍后重试」&#xa;（就显示在弹窗里，关掉可以重试）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="640" y="710" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n_end" value="关掉弹窗。&#xa;结果不保存 —— 每次点都会重新评估一次，&#xa;想再看得重新点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="370" y="880" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e_0" value="" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_s" target="n_panel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_1" value="" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_panel" target="n_linked">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_2" value="没关联" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;edgeStyle=none;exitX=0.75;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_linked" target="n_disabled">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_3" value="关联了" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_linked" target="n_click">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_4" value="成功" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_click" target="n_shown">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_5" value="AI 失败" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;edgeStyle=none;exitX=0.75;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_shown" target="n_fail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_6" value="" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_shown" target="n_end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
