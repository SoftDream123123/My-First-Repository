        <mxCell id="n_s" value="打开一场「进行中」的&#xa;面试详情页" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="370" y="40" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n_nav" value="在左侧「题目」里点一道题&#xa;（默认停在第一道没答的）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="370" y="190" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n_input" value="在「候选人回答」里&#xa;边听边记" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="370" y="340" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n_save" value="点到别处让它自动保存，&#xa;或直接点「保存回答」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
