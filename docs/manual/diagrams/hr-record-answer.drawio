        </mxCell>
        <mxCell id="n_ok" value="右上角显示「已保存」，&#xa;左侧这道题标成「已答」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="70" y="790" width="220" height="70" as="geometry" />
