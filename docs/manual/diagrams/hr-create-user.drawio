        <mxCell id="n_s" value="在左侧导航点「用户管理」&#xa;（只有管理员看得到）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
