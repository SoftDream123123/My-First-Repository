<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="cand-link-resume">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n_s" value="在「我的简历」里选中一份，&#xa;点右侧「用于面试」" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="370" y="40" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n_dlg" value="弹出「这份简历用在哪些面试？」，&#xa;列着每一场当前的情况" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="370" y="190" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n_pick" value="勾上想用这份简历的场次；&#xa;取消勾选就是解除关联" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="370" y="340" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n_save" value="点「保存」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="370" y="490" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n_done" value="成功了吗？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="370" y="640" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n_ok" value="看到「已更新关联」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="70" y="790" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n_fail" value="看到报错提示；&#xa;界面会刷新成真实状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="370" y="790" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n_frozen" value="面试已结束的那一行是灰的，&#xa;写着「本场面试已结束，关联已冻结」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="670" y="790" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e_0" value="" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_s" target="n_dlg">
