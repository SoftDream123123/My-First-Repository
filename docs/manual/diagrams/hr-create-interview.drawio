        </mxCell>
        <mxCell id="n_name" value="在「候选人姓名」里填名字，&#xa;「联系方式」可不填" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="370" y="340" width="220" height="70" as="geometry" />
        </mxCell>
