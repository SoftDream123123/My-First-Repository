        <mxCell id="n_wrong" value="看到「用户名或密码错误」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="220" y="790" width="220" height="70" as="geometry" />
